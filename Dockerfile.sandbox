# Sandbox image for code execution
# This image is used by the CodeExecutionAgent to run user-generated code

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install data analysis libraries
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    numpy==1.26.2 \
    sqlalchemy==2.0.23 \
    asyncpg==0.29.0 \
    psycopg2-binary==2.9.9 \
    scikit-learn==1.3.2 \
    matplotlib==3.8.2 \
    seaborn==0.13.0

# Create non-root user
RUN useradd --create-home --shell /bin/bash sandbox

# Set work directory
WORKDIR /sandbox

# Switch to non-root user
USER sandbox

# Default command
CMD ["python"]
